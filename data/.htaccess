# Protect SQLite database & local SaaS state from direct HTTP access
<FilesMatch "\.(db|sqlite|sqlite3|log|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
